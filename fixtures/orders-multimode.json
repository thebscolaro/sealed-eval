{
  "task_card": {
    "id": "orders-v2",
    "title": "Orders API multi-mode",
    "summary": "Contract, golden, and invariant checks against subject-demo",
    "public_acceptance": [
      "GET /health returns ok",
      "POST /orders returns 201",
      "Health body never contains traceback",
      "GET /health golden matches ok true"
    ]
  },
  "cases": [
    {
      "id": "health",
      "check": "contract",
      "bucket": "health",
      "request": { "method": "GET", "path": "/health" },
      "expect": { "status": 200, "json_contains": { "ok": true } },
      "visible": true
    },
    {
      "id": "create-order",
      "check": "contract",
      "bucket": "orders",
      "request": {
        "method": "POST",
        "path": "/orders",
        "json": { "sku": "abc", "qty": 2 }
      },
      "expect": {
        "status": 201,
        "json_contains": { "sku": "abc", "qty": 2 }
      },
      "visible": false
    },
    {
      "id": "get-order",
      "check": "contract",
      "bucket": "orders",
      "request": { "method": "GET", "path": "/orders/{last_id}" },
      "expect": {
        "status": 200,
        "json_contains": { "sku": "abc", "qty": 2 }
      },
      "visible": false
    },
    {
      "id": "health-invariant",
      "check": "invariant",
      "bucket": "invariant",
      "request": { "method": "GET", "path": "/health" },
      "expect": {
        "status": 200,
        "never_contains": ["traceback", "secret"]
      },
      "visible": false
    },
    {
      "id": "health-golden",
      "check": "holdout_golden",
      "bucket": "golden",
      "request": { "method": "GET", "path": "/health" },
      "expect": {
        "status": 200,
        "json_equals": { "ok": true }
      },
      "visible": false
    }
  ]
}
