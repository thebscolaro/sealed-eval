{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scorecard",
  "type": "object",
  "required": ["suite_id", "passed", "total", "ok", "gate"],
  "properties": {
    "suite_id": { "type": "string" },
    "passed": { "type": "boolean" },
    "total": { "type": "integer" },
    "ok": { "type": "integer" },
    "visible_heldout_gap": { "type": "number" },
    "buckets": { "type": "object" },
    "gate": { "type": "string", "enum": ["pass", "fail", "retry"] }
  }
}
